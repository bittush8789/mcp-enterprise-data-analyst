# Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=enterprise_analytics
MYSQL_USER=root
MYSQL_PASSWORD=root

# ChromaDB Configuration (leave host/port empty for local persistent directory)
CHROMA_HOST=
CHROMA_PORT=
CHROMA_PERSIST_DIR=./data/chroma_db

# Hybrid RAG Weights & Retrieval Configuration
SEMANTIC_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
TOP_K=5
RERANKER_ENABLED=true

# Guardrails & Operational Constraints
MAX_ROWS=1000
QUERY_TIMEOUT=10
MAX_INPUT_LENGTH=2000
LOG_LEVEL=INFO
